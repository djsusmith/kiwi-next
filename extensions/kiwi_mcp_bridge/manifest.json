{
  "manifest_version": 3,
  "name": "Kiwi MCP Bridge",
  "version": "1.1.1",
  "description": "Exposes Kiwi Browser tabs, navigation, JS evaluation, and screenshots to local MCP tools.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html",
    "default_title": "Kiwi MCP Bridge"
  }
}
