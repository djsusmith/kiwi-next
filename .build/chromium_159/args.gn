target_os = "android"
target_cpu = "arm64"
is_debug = false
is_java_debug = false
is_component_build = false
is_official_build = false
is_chrome_branded = false
is_clang = true

symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

android_channel = "dev"
android_default_version_code = "815700003"
android_default_version_name = "160.0.8157.3-kiwi-mcp"

ffmpeg_branding = "Chrome"
proprietary_codecs = true
enable_widevine = true

v8_use_external_startup_data = true
# Chromium 160 uses enable_desktop_android_extensions on Android instead of desktop enable_extensions = true
enable_desktop_android_extensions = true
enable_pdf = false
enable_plugins = false

disable_android_lint = true
treat_warnings_as_errors = false
